<%- include('partials/header') %>

<div class="max-w-4xl mx-auto">
    <header class="mb-10 text-center sm:text-left">
        <h1 class="fui-brand text-2xl md:text-3xl font-black text-cyan-300 fui-tracked" style="text-shadow: 0 0 20px rgba(34,229,255,0.3);"><%= t('site.selectserver.title').toUpperCase() %></h1>
        <p class="text-slate-400 mt-2 text-sm md:text-base"><%= t('site.selectserver.subtitle', { username: user.username }) %></p>
        <% if (typeof isBotOwner !== 'undefined' && isBotOwner) { %>
            <a href="/dev" class="inline-block mt-3 text-xs text-slate-500 hover:text-cyan-300 fui-tracked uppercase">Developer</a>
        <% } %>
    </header>

    <!-- ACTIVE SERVERS -->
    <section class="mb-12">
        <h2 class="fui-section-title flex items-center gap-2">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
            </span>
            <%= t('site.selectserver.active_heading') %>
        </h2>

        <% if (guildsWithBot.length === 0) { %>
            <div class="fui-panel fui-corners p-8 text-center text-slate-500 text-sm mt-4">
                <%= (typeof noAdminServers !== 'undefined' && noAdminServers) ? t('site.selectserver.no_admin_servers') : t('site.selectserver.no_active_servers') %>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <% guildsWithBot.forEach(guild => { %>
                    <form action="/select-server" method="POST">
                        <input type="hidden" name="guild_id" value="<%= guild.id %>">
                        <button type="submit" class="fui-panel fui-corners w-full flex items-center gap-4 p-4 hover:border-cyan-400/60 transition-all text-left group">
                            <div class="w-12 h-12 rounded-full overflow-hidden bg-black/60 flex-shrink-0 border border-cyan-500/20 group-hover:border-cyan-400/50 transition">
                                <% if (guild.icon) { %>
                                    <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Icon" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-cyan-300 font-bold bg-black/60"><%= guild.name.charAt(0) %></div>
                                <% } %>
                            </div>
                            <div class="text-left overflow-hidden flex-1">
                                <h3 class="font-semibold text-white truncate"><%= guild.name %></h3>
                                <span class="inline-block text-[10px] font-bold fui-tracked uppercase px-1.5 py-0.5 mr-1 border <%= guild.owner ? 'text-fuchsia-300 border-fuchsia-500/50' : 'text-cyan-300 border-cyan-500/40' %>"><%= guild.owner ? t('site.selectserver.role_owner') : t('site.selectserver.role_admin') %></span>
                                <span class="text-xs text-cyan-400 font-medium fui-tracked uppercase"><%= t('site.selectserver.active_badge') %></span>
                                <%
                                    const sp = (typeof setup !== 'undefined' && setup) ? setup[guild.id] : null;
                                    let spPct = 0, spText = '', spBar = '', spDetail = '', spWidth = '';
                                    if (sp) {
                                        spPct = sp.percent;
                                        spText = spPct >= 70 ? 'text-cyan-300' : (spPct >= 30 ? 'text-slate-300' : 'text-fuchsia-300');
                                        spBar = spPct >= 70 ? 'bg-cyan-400' : (spPct >= 30 ? 'bg-slate-400' : 'bg-fuchsia-400');
                                        spDetail = t('site.selectserver.setup_detail', { done: sp.done, total: sp.total });
                                        spWidth = 'w-[' + spPct + '%]';
                                    }
                                %>
                                <% if (sp) { %>
                                    <div class="mt-2" title="<%= spDetail %>">
                                        <div class="flex items-center justify-between text-[10px] text-slate-500 fui-tracked uppercase mb-1">
                                            <span><%= t('site.selectserver.setup_label') %></span>
                                            <span class="<%= spText %>"><%= spPct + '%' %></span>
                                        </div>
                                        <div class="h-1 w-full bg-white/5">
                                            <div class="h-1 <%= spBar %> <%= spWidth %>"></div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <span class="text-slate-600 group-hover:text-cyan-400 transition text-xl">→</span>
                        </button>
                    </form>
                <% }) %>
            </div>
        <% } %>
    </section>

    <!-- ARTIST PANELS: servers where this person is an artist -->
    <% if (typeof artistGuildList !== 'undefined' && artistGuildList.length > 0) { %>
        <section class="mb-12">
            <h2 class="fui-section-title" style="color: #ff6fa0;"><%= t('site.selectserver.artist_heading') %></h2>
            <p class="text-xs text-slate-500 mt-1"><%= t('site.selectserver.artist_hint') %></p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <% artistGuildList.forEach(guild => { %>
                    <a href="/artist-panel/<%= guild.id %>" class="fui-panel fui-corners flex items-center gap-4 p-4 hover:border-fuchsia-400/60 transition-all group">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-black/60 flex-shrink-0 border border-fuchsia-500/30">
                            <% if (guild.icon) { %>
                                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-fuchsia-300 font-bold bg-black/60"><%= guild.name.charAt(0) %></div>
                            <% } %>
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <h3 class="font-semibold text-white truncate"><%= guild.name %></h3>
                            <span class="inline-block text-[10px] font-bold fui-tracked uppercase px-1.5 py-0.5 mr-1 border text-fuchsia-300 border-fuchsia-500/50"><%= t('site.selectserver.role_artist') %></span>
                            <span class="text-xs text-slate-400"><%= t('site.selectserver.artist_open') %></span>
                        </div>
                        <span class="text-slate-600 group-hover:text-fuchsia-400 transition text-xl">&rarr;</span>
                    </a>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- NO PERMISSION: Astra is here, but this account can't configure it -->
    <% if (typeof guildsNoAccess !== 'undefined' && guildsNoAccess.length > 0) { %>
        <section class="mb-12">
            <h2 class="fui-section-title" style="color: #94a3b8;"><%= t('site.selectserver.noaccess_heading') %></h2>
            <p class="text-xs text-slate-500 mt-1"><%= t('site.selectserver.noaccess_hint') %></p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <% guildsNoAccess.forEach(guild => { %>
                    <div class="fui-panel fui-corners flex items-center gap-4 p-4" style="opacity: 0.7;">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-black/60 flex-shrink-0 border border-slate-700">
                            <% if (guild.icon) { %>
                                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Icon" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-500 font-bold bg-black/60"><%= guild.name.charAt(0) %></div>
                            <% } %>
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <h3 class="font-semibold text-slate-300 truncate"><%= guild.name %></h3>
                            <span class="inline-block text-[10px] font-bold fui-tracked uppercase px-1.5 py-0.5 mr-1 border text-slate-400 border-slate-600"><%= t('site.selectserver.role_member') %></span>
                            <span class="text-xs text-fuchsia-300"><%= t('site.selectserver.no_permission') %></span>
                        </div>
                        <span class="text-slate-600 text-lg" aria-hidden="true">&#128274;</span>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- NEEDS INVITE -->
    <% if (guildsWithoutBot.length > 0) { %>
        <section>
            <h2 class="fui-section-title" style="color: #94a3b8;"><%= t('site.selectserver.needs_invite_heading') %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <% guildsWithoutBot.forEach(guild => { %>
                    <div class="fui-panel fui-corners flex items-center gap-4 p-4" style="opacity: 0.85;">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-black/60 flex-shrink-0 border border-slate-700 grayscale opacity-70">
                            <% if (guild.icon) { %>
                                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Icon" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-500 font-bold bg-black/60"><%= guild.name.charAt(0) %></div>
                            <% } %>
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <h3 class="font-semibold text-slate-300 truncate"><%= guild.name %></h3>
                            <span class="inline-block text-[10px] font-bold fui-tracked uppercase px-1.5 py-0.5 mr-1 border <%= guild.owner ? 'text-fuchsia-300 border-fuchsia-500/50' : 'text-slate-400 border-slate-500/40' %>"><%= guild.owner ? t('site.selectserver.role_owner') : t('site.selectserver.role_admin') %></span>
                            <span class="text-xs text-slate-500"><%= t('site.selectserver.not_added_badge') %></span>
                        </div>
                        <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=<%= botInvitePermissions %>&scope=bot%20applications.commands&guild_id=<%= guild.id %>&disable_guild_select=true"
                            target="_blank" rel="noopener"
                            class="fui-btn text-xs py-2 px-4 text-cyan-300 border-cyan-500/30 whitespace-nowrap">
                            <%= t('site.selectserver.invite_button') %>
                        </a>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>
</div>

<%- include('partials/footer') %>