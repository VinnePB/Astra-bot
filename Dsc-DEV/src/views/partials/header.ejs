<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Projeckt V: Astra' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --fui-bg: #05070a;
            --fui-cyan: #22e5ff;
            --fui-magenta: #ff2e6d;
            --fui-line: rgba(34, 229, 255, 0.28);
        }
        body { font-family: 'Rajdhani', sans-serif; background-color: var(--fui-bg); }
        .fui-brand { font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em; }
        .fui-tracked { letter-spacing: 0.14em; }

        .fui-panel {
            background: linear-gradient(160deg, rgba(10,15,22,0.92), rgba(5,7,10,0.96));
            border: 1px solid var(--fui-line);
            clip-path: polygon(0 14px, 14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
            box-shadow: 0 0 0 1px rgba(34,229,255,0.03), 0 8px 32px -8px rgba(0,0,0,0.6);
            position: relative;
        }
        .fui-corners::before, .fui-corners::after {
            content: ''; position: absolute; width: 14px; height: 14px;
            border-color: var(--fui-cyan); pointer-events: none; opacity: 0.85;
        }
        .fui-corners::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
        .fui-corners::after { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }

        .fui-btn {
            font-family: 'Rajdhani', sans-serif;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
            border: 1px solid var(--fui-line);
            transition: all 0.15s ease;
        }
        .fui-btn:hover { border-color: var(--fui-cyan); box-shadow: 0 0 16px -2px rgba(34,229,255,0.5), inset 0 0 12px -4px rgba(34,229,255,0.3); }

        .fui-scanline {
            position: fixed; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(34,229,255,0.5), transparent);
            animation: fui-sweep 9s linear infinite; pointer-events: none; z-index: 0;
        }
        @keyframes fui-sweep { 0% { top: 0%; } 100% { top: 100%; } }

        .fui-grid-bg {
            background-image:
                linear-gradient(rgba(34,229,255,0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(34,229,255,0.035) 1px, transparent 1px);
            background-size: 42px 42px;
        }

        /* Nav popup — click toggles it (works on every device), and on
           devices with a real pointer it also opens on hover, as asked for. */
        #astra-nav-popup { display: none; }
        #astra-nav-popup.open { display: block; }
        @media (hover: hover) {
            #astra-nav-trigger:hover + #astra-nav-popup,
            #astra-nav-popup:hover { display: block; }
        }

        /* Shared form/content utility classes — used across Dashboard,
           Onboarding, and anywhere else that needs the FUI look. Defined
           once here so every page that includes this header gets them. */
        .fui-input {
            background: rgba(0,0,0,0.5);
            border: 1px solid rgba(34,229,255,0.2);
            color: #e8fbff;
            padding: 0.75rem;
            font-size: 0.875rem;
            outline: none;
            transition: border-color 0.15s ease;
            width: 100%;
        }
        .fui-input:focus { border-color: var(--fui-cyan); }
        .fui-label { display: block; font-size: 0.7rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; }
        .fui-section-title { font-size: 0.8rem; font-weight: 700; color: var(--fui-cyan); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.25rem; }
        .fui-badge { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.7rem; border: 1px solid; white-space: nowrap; }
        .fui-tab-btn {
            font-family: 'Rajdhani', sans-serif;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 0.65rem 1.1rem;
            color: #64748b;
            border-bottom: 2px solid transparent;
            transition: all 0.15s ease;
            white-space: nowrap;
        }
        .fui-tab-btn:hover { color: #67e8f9; }
        .fui-tab-btn.active { color: var(--fui-cyan); border-bottom-color: var(--fui-cyan); }
        .fui-tab-panel { display: none; }
        .fui-tab-panel.active { display: block; }
    </style>
</head>
<body class="text-slate-100 min-h-screen relative">

    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 fui-grid-bg">
        <div class="absolute -top-32 -left-24 w-[28rem] h-[28rem] bg-cyan-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute top-1/2 -right-32 w-[26rem] h-[26rem] bg-fuchsia-600/10 rounded-full blur-[120px]"></div>
        <div class="absolute -bottom-32 left-1/3 w-[24rem] h-[24rem] bg-cyan-500/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="fui-scanline"></div>

    <!-- TOP BAR — same on every screen size, no sidebar, no overlay -->
    <div class="relative z-30 flex items-center justify-between px-4 sm:px-6 py-3 border-b border-cyan-500/15 bg-black/60 backdrop-blur sticky top-0">
        <div class="relative">
            <button id="astra-nav-trigger" class="flex items-center gap-2 group" aria-haspopup="true">
                <% if (typeof user !== 'undefined' && user && user.avatar) { %>
                    <% const avatarExt = user.avatar.startsWith('a_') ? 'gif' : 'png'; %>
                    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.<%= avatarExt %>" class="w-7 h-7 rounded-full border border-cyan-500/30" alt=""
                        onerror="this.replaceWith(Object.assign(document.createElement('div'), {className: 'w-7 h-7 bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-xs font-bold text-cyan-300', textContent: '<%= user.username.charAt(0).toUpperCase() %>'}))">
                <% } else if (typeof user !== 'undefined' && user) { %>
                    <div class="w-7 h-7 bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-xs font-bold text-cyan-300"><%= user.username.charAt(0).toUpperCase() %></div>
                <% } %>
                <span class="leading-none text-left">
                    <span class="fui-brand block text-sm font-bold text-cyan-300 fui-tracked group-hover:text-cyan-200 transition">PROJECKT V<span class="text-slate-500 font-normal"> : ASTRA</span></span>
                </span>
                <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-cyan-300 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </button>

            <div id="astra-nav-popup" class="fui-panel fui-corners absolute left-0 top-full mt-2 w-60 py-2 z-50">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="flex items-center gap-2.5 px-4 py-2.5 border-b border-cyan-500/15 mb-1">
                        <% if (user.avatar) { %>
                            <% const popupAvatarExt = user.avatar.startsWith('a_') ? 'gif' : 'png'; %>
                            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.<%= popupAvatarExt %>" class="w-9 h-9 rounded-full border border-cyan-500/30 shrink-0" alt=""
                                onerror="this.replaceWith(Object.assign(document.createElement('div'), {className: 'w-9 h-9 bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-sm font-bold text-cyan-300 shrink-0', textContent: '<%= user.username.charAt(0).toUpperCase() %>'}))">
                        <% } else { %>
                            <div class="w-9 h-9 bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-sm font-bold text-cyan-300 shrink-0"><%= user.username.charAt(0).toUpperCase() %></div>
                        <% } %>
                        <div class="min-w-0">
                            <div class="text-xs text-slate-500 fui-tracked uppercase">Signed in as</div>
                            <div class="text-sm font-semibold text-white truncate"><%= user.username %></div>
                        </div>
                    </div>
                <% } %>
                <a href="/onboarding" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-300 hover:text-cyan-300 hover:bg-cyan-500/10 transition fui-tracked uppercase text-xs">
                    <span class="w-1 h-1 bg-slate-600 rotate-45 shrink-0"></span> Help &amp; Setup
                </a>
                <a href="/dashboard" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-300 hover:text-cyan-300 hover:bg-cyan-500/10 transition fui-tracked uppercase text-xs">
                    <span class="w-1 h-1 bg-slate-600 rotate-45 shrink-0"></span> Configuration
                </a>
                <a href="/select-server" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-300 hover:text-cyan-300 hover:bg-cyan-500/10 transition fui-tracked uppercase text-xs">
                    <span class="w-1 h-1 bg-slate-600 rotate-45 shrink-0"></span> Switch Server
                </a>
                <a href="/logout" class="flex items-center gap-2 px-4 py-2 text-sm text-fuchsia-400 hover:bg-fuchsia-500/10 transition fui-tracked uppercase text-xs mt-1 border-t border-cyan-500/15 pt-2">
                    <span class="w-1 h-1 bg-fuchsia-500 rotate-45 shrink-0"></span> Logout
                </a>
            </div>
        </div>

        <div class="flex items-center gap-1 text-xs border border-cyan-500/20 p-1">
            <a href="/lang/en" class="px-2.5 py-1 transition fui-tracked text-slate-500 hover:text-cyan-300">EN</a>
            <a href="/lang/pt-br" class="px-2.5 py-1 transition fui-tracked text-slate-500 hover:text-cyan-300">PT-BR</a>
        </div>
    </div>

    <main class="relative z-10 p-4 sm:p-6 md:p-10">