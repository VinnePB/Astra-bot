<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Projeckt V: Astra' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --fui-bg: #05070a;
            --fui-panel: #0a0f16;
            --fui-cyan: #22e5ff;
            --fui-cyan-dim: #0b7a8f;
            --fui-magenta: #ff2e6d;
            --fui-line: rgba(34, 229, 255, 0.28);
            --fui-line-soft: rgba(34, 229, 255, 0.12);
        }
        body { font-family: 'Rajdhani', sans-serif; background-color: var(--fui-bg); }
        .fui-brand { font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em; }
        .fui-tracked { letter-spacing: 0.14em; }

        /* Angular panel: corners cut diagonally, thin glowing cyan border */
        .fui-panel {
            background: linear-gradient(160deg, rgba(10,15,22,0.92), rgba(5,7,10,0.96));
            border: 1px solid var(--fui-line);
            clip-path: polygon(0 14px, 14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
            box-shadow: 0 0 0 1px rgba(34,229,255,0.03), 0 8px 32px -8px rgba(0,0,0,0.6);
            position: relative;
        }
        .fui-panel::before {
            content: '';
            position: absolute; inset: 0;
            background-image:
                repeating-linear-gradient(0deg, rgba(34,229,255,0.015) 0px, rgba(34,229,255,0.015) 1px, transparent 1px, transparent 3px);
            pointer-events: none;
        }

        /* Corner bracket accents — HUD targeting-reticle look */
        .fui-corners::before, .fui-corners::after {
            content: ''; position: absolute; width: 14px; height: 14px;
            border-color: var(--fui-cyan); pointer-events: none; opacity: 0.85;
        }
        .fui-corners::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
        .fui-corners::after { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }

        .fui-btn {
            font-family: 'Rajdhani', sans-serif;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
            border: 1px solid var(--fui-line);
            transition: all 0.15s ease;
        }
        .fui-btn:hover {
            border-color: var(--fui-cyan);
            box-shadow: 0 0 16px -2px rgba(34,229,255,0.5), inset 0 0 12px -4px rgba(34,229,255,0.3);
        }

        /* Thin animated scanline sweeping the viewport — subtle, decorative */
        .fui-scanline {
            position: fixed; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(34,229,255,0.5), transparent);
            animation: fui-sweep 9s linear infinite;
            pointer-events: none; z-index: 0;
        }
        @keyframes fui-sweep { 0% { top: 0%; } 100% { top: 100%; } }

        .fui-grid-bg {
            background-image:
                linear-gradient(rgba(34,229,255,0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(34,229,255,0.035) 1px, transparent 1px);
            background-size: 42px 42px;
        }
    </style>
</head>
<body class="text-slate-100 min-h-screen relative">

    <!-- Background: grid + soft glow + sweeping scanline, recolored cyan/magenta for the FUI look -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 fui-grid-bg">
        <div class="absolute -top-32 -left-24 w-[28rem] h-[28rem] bg-cyan-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute top-1/2 -right-32 w-[26rem] h-[26rem] bg-fuchsia-600/10 rounded-full blur-[120px]"></div>
        <div class="absolute -bottom-32 left-1/3 w-[24rem] h-[24rem] bg-cyan-500/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="fui-scanline"></div>

    <!-- Mobile top bar -->
    <div class="md:hidden flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/90 backdrop-blur sticky top-0 z-40">
        <span class="fui-brand text-base font-bold text-cyan-300 fui-tracked">PROJECKT V <span class="text-slate-500 font-normal">: ASTRA</span></span>
        <button id="astra-menu-toggle" class="p-2 border border-cyan-500/30 text-cyan-300 active:scale-95 transition" aria-label="Open menu" style="clip-path: polygon(0 6px, 6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>

    <div id="astra-overlay" class="fixed inset-0 bg-black/70 z-40 hidden"></div>

    <div class="flex min-h-screen relative z-10">
        <aside id="astra-sidebar"
            class="fixed md:static top-0 left-0 h-full w-72 md:w-64 border-r border-cyan-500/15 p-6 bg-black/70 md:bg-black/40 backdrop-blur-xl z-50
                   transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out overflow-y-auto">
            <div class="flex items-center justify-between mb-10">
                <div class="hidden md:block leading-none">
                    <div class="fui-brand text-lg font-extrabold text-cyan-300 fui-tracked">PROJECKT V</div>
                    <div class="fui-tracked text-[11px] text-slate-500 mt-1">: ASTRA</div>
                </div>
                <span class="fui-brand text-lg font-bold text-cyan-300 md:hidden fui-tracked">MENU</span>
                <button id="astra-menu-close" class="md:hidden text-slate-500 hover:text-cyan-300 text-xl leading-none px-2" aria-label="Close menu">✕</button>
            </div>
            <nav class="space-y-1">
                <a href="/onboarding" class="flex items-center gap-3 py-2.5 px-3 text-slate-400 hover:text-cyan-300 hover:bg-cyan-500/5 border-l-2 border-transparent hover:border-cyan-400 transition fui-tracked text-sm uppercase">
                    <span class="w-1.5 h-1.5 bg-slate-600 rotate-45 shrink-0"></span> Help &amp; Setup
                </a>
                <a href="/dashboard" class="flex items-center gap-3 py-2.5 px-3 text-cyan-300 bg-cyan-500/10 border-l-2 border-cyan-400 transition fui-tracked text-sm uppercase">
                    <span class="w-1.5 h-1.5 bg-cyan-400 rotate-45 shrink-0"></span> Configuration
                </a>
                <a href="/tickets" class="flex items-center gap-3 py-2.5 px-3 text-slate-400 hover:text-cyan-300 hover:bg-cyan-500/5 border-l-2 border-transparent hover:border-cyan-400 transition fui-tracked text-sm uppercase">
                    <span class="w-1.5 h-1.5 bg-slate-600 rotate-45 shrink-0"></span> Tickets
                </a>
                <a href="/select-server" class="flex items-center gap-3 py-2.5 px-3 text-slate-400 hover:text-cyan-300 hover:bg-cyan-500/5 border-l-2 border-transparent hover:border-cyan-400 transition fui-tracked text-sm uppercase">
                    <span class="w-1.5 h-1.5 bg-slate-600 rotate-45 shrink-0"></span> Switch Server
                </a>
                <a href="/logout" class="flex items-center gap-3 py-2.5 px-3 text-slate-500 hover:text-fuchsia-400 hover:bg-fuchsia-500/5 border-l-2 border-transparent hover:border-fuchsia-500 transition fui-tracked text-sm uppercase mt-8">
                    <span class="w-1.5 h-1.5 bg-slate-600 rotate-45 shrink-0"></span> Logout
                </a>
            </nav>
        </aside>

        <main class="flex-1 w-full min-w-0 p-4 sm:p-6 md:p-10">
