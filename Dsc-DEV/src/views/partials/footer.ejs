</main>

    <script>
        // Nav popup — click toggles it open/closed (the reliable baseline for
        // every device); header.ejs's CSS also opens it on hover for devices
        // with a real pointer. Clicking anywhere outside closes it.
        (function () {
            const trigger = document.getElementById('astra-nav-trigger');
            const popup = document.getElementById('astra-nav-popup');
            if (!trigger || !popup) return;

            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                popup.classList.toggle('open');
            });
            popup.addEventListener('click', (e) => e.stopPropagation());
            document.addEventListener('click', () => popup.classList.remove('open'));
        })();
    </script>

    <script>
        // NEW: auto-save for settings forms. Any <form data-autosave> submits
        // itself via fetch the instant a select/checkbox/radio inside it
        // changes — no separate "click Save to confirm" step. Text/number
        // inputs auto-save too, but debounced, so it doesn't fire on every
        // keystroke. Falls back to a normal full-page submit if JS is
        // disabled, since the form's action/method still work as plain HTML.
        //
        // Deliberately NOT applied to forms that trigger a real Discord side
        // effect (posting a panel message, creating/deleting something) —
        // those keep their explicit button so a settings tweak can never
        // accidentally re-trigger an action with visible side effects.
        (function () {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 bg-black border border-cyan-400/60 text-cyan-300 text-sm font-semibold px-4 py-2.5 shadow-[0_0_20px_-4px_rgba(34,229,255,0.6)] z-50 opacity-0 pointer-events-none transition-opacity duration-200';
            toast.style.clipPath = 'polygon(0 8px, 8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%)';
            toast.style.fontFamily = "'Rajdhani', sans-serif";
            toast.style.letterSpacing = '0.08em';
            toast.textContent = '// SAVED';
            document.body.appendChild(toast);

            let toastTimer;
            function showSaved() {
                toast.style.opacity = '1';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => { toast.style.opacity = '0'; }, 1500);
            }

            async function autosave(form) {
                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'fetch' },
                        body: new FormData(form)
                    });
                    if (res.ok) {
                        // A form marked data-autosave-reload (currently just the
                        // Language selector) changes what language the REST of
                        // the page renders in — a fetch-based save alone can't
                        // show that, so this one does a real reload instead of
                        // just a toast, same as if you'd clicked a normal button.
                        if (form.hasAttribute('data-autosave-reload')) {
                            window.location.reload();
                        } else {
                            showSaved();
                        }
                    }
                } catch (err) {
                    console.error('Autosave failed:', err);
                }
            }

            document.querySelectorAll('form[data-autosave]').forEach((form) => {
                form.addEventListener('change', (e) => {
                    if (e.target.matches('select, input[type="checkbox"], input[type="radio"]')) {
                        autosave(form);
                    }
                });

                let debounceTimer;
                form.addEventListener('input', (e) => {
                    if (e.target.matches('input[type="text"], input[type="number"]')) {
                        clearTimeout(debounceTimer);
                        debounceTimer = setTimeout(() => autosave(form), 800);
                    }
                });
            });
        })();
    </script>
</body>
</html>