<!DOCTYPE html>
<html lang="<%= lang === 'pt-br' ? 'pt-BR' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeckt V: Astra</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/logo.png">
    <meta property="og:title" content="Projeckt V: Astra">
    <meta property="og:image" content="/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --fui-cyan: #22e5ff;
            --fui-line: rgba(34, 229, 255, 0.28);
        }
        body { font-family: 'Rajdhani', sans-serif; background-color: #05070a; color: #e8fbff; }
        .fui-brand { font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em; }
        .fui-tracked { letter-spacing: 0.14em; }

        .fui-panel {
            background: linear-gradient(160deg, rgba(10,15,22,0.9), rgba(5,7,10,0.95));
            border: 1px solid var(--fui-line);
            clip-path: polygon(0 16px, 16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
            position: relative;
        }
        .fui-corners::before, .fui-corners::after {
            content: ''; position: absolute; width: 16px; height: 16px;
            border-color: var(--fui-cyan); pointer-events: none; opacity: 0.85;
        }
        .fui-corners::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
        .fui-corners::after { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }

        .fui-btn {
            font-family: 'Rajdhani', sans-serif;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
            border: 1px solid var(--fui-line);
            transition: all 0.15s ease;
        }
        .fui-btn:hover { border-color: var(--fui-cyan); box-shadow: 0 0 20px -2px rgba(34,229,255,0.55), inset 0 0 14px -4px rgba(34,229,255,0.3); }
        .fui-btn-solid { background: rgba(34,229,255,0.1); border-color: var(--fui-cyan); color: var(--fui-cyan); }
        .fui-btn-solid:hover { background: rgba(34,229,255,0.18); }

        .fui-grid-bg {
            background-image:
                linear-gradient(rgba(34,229,255,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(34,229,255,0.04) 1px, transparent 1px);
            background-size: 42px 42px;
        }
        .fui-scanline {
            position: fixed; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(34,229,255,0.5), transparent);
            animation: fui-sweep 9s linear infinite; pointer-events: none; z-index: 0;
        }
        @keyframes fui-sweep { 0% { top: 0%; } 100% { top: 100%; } }
    </style>
</head>
<body class="min-h-screen antialiased relative overflow-x-hidden">

    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 fui-grid-bg">
        <div class="absolute -top-32 -left-24 w-[28rem] h-[28rem] bg-cyan-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute top-1/2 -right-32 w-[26rem] h-[26rem] bg-fuchsia-600/10 rounded-full blur-[120px]"></div>
        <div class="absolute -bottom-32 left-1/3 w-[24rem] h-[24rem] bg-cyan-500/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="fui-scanline"></div>

    <!-- TOP BAR -->
    <div class="flex items-center justify-between px-5 sm:px-8 py-5 max-w-6xl mx-auto relative z-10">
        <div class="leading-none">
            <div class="fui-brand text-base sm:text-lg font-extrabold text-cyan-300 fui-tracked">PROJECKT V</div>
            <div class="fui-tracked text-[10px] text-slate-500">: ASTRA</div>
        </div>

        <div class="flex items-center gap-4">
            <a href="/support" class="fui-btn text-xs px-3 py-1.5 text-fuchsia-300 hover:text-fuchsia-200" style="border-color: rgba(255,46,109,0.5);"><span aria-hidden="true">&#9829;</span> <%= t('site.support.nav') %></a>
            <div class="flex items-center gap-1 text-xs border border-cyan-500/20 p-1">
                <a href="/lang/en" class="px-2.5 py-1 transition fui-tracked <%= lang === 'en' ? 'bg-cyan-500/20 text-cyan-300' : 'text-slate-500 hover:text-cyan-300' %>">EN</a>
                <a href="/lang/pt-br" class="px-2.5 py-1 transition fui-tracked <%= lang === 'pt-br' ? 'bg-cyan-500/20 text-cyan-300' : 'text-slate-500 hover:text-cyan-300' %>">PT-BR</a>
            </div>

            <% if (loggedIn) { %>
                <div class="relative">
                    <button id="astra-user-menu-btn" class="flex items-center gap-2 bg-white/5 hover:bg-cyan-500/10 border border-cyan-500/20 hover:border-cyan-400/50 pl-1.5 pr-3 py-1.5 transition">
                        <% if (user.avatar) { %>
                            <% const avatarExt = user.avatar.startsWith('a_') ? 'gif' : 'png'; %>
                            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.<%= avatarExt %>" class="w-6 h-6 rounded-full" alt=""
                                onerror="this.replaceWith(Object.assign(document.createElement('div'), {className: 'w-6 h-6 bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-xs font-bold text-cyan-300', textContent: '<%= user.username.charAt(0).toUpperCase() %>'}))">
                        <% } else { %>
                            <div class="w-6 h-6 bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-xs font-bold text-cyan-300"><%= user.username.charAt(0).toUpperCase() %></div>
                        <% } %>
                        <span class="text-sm font-medium text-slate-200 hidden sm:inline"><%= t('site.home.greeting', { username: user.username }) %></span>
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <div id="astra-user-menu" class="hidden absolute right-0 mt-2 w-44 bg-black border border-cyan-500/25 shadow-[0_0_24px_-6px_rgba(34,229,255,0.4)] overflow-hidden z-50">
                        <a href="/select-server" class="block px-4 py-2.5 text-sm text-slate-300 hover:bg-cyan-500/10 hover:text-cyan-300 transition fui-tracked uppercase text-xs"><%= t('site.home.go_to_dashboard') %></a>
                        <a href="/logout" class="block px-4 py-2.5 text-sm text-fuchsia-400 hover:bg-fuchsia-500/10 transition fui-tracked uppercase text-xs"><%= t('site.home.logout') %></a>
                    </div>
                </div>
            <% } else { %>
                <a href="/login" class="fui-btn fui-btn-solid text-sm font-semibold py-2 px-4">
                    <%= t('site.home.login_button') %>
                </a>
            <% } %>
        </div>
    </div>

    <!-- HERO -->
    <div class="max-w-3xl mx-auto px-5 sm:px-8 pt-14 pb-20 text-center relative z-10">
        <img src="/logo.svg" alt="Projeckt V: Astra logo" width="112" height="112" class="mx-auto mb-6 w-24 h-24 sm:w-28 sm:h-28" style="filter: drop-shadow(0 0 22px rgba(34,229,255,0.35));">
        <div class="fui-tracked text-xs text-cyan-500/70 mb-5">// DISCORD SECURITY &amp; COMMUNITY BOT</div>
        <h1 class="fui-brand text-4xl sm:text-6xl font-black text-cyan-300 tracking-tight mb-2" style="text-shadow: 0 0 30px rgba(34,229,255,0.35);">
            PROJECKT V
        </h1>
        <div class="fui-brand text-3xl sm:text-5xl font-extrabold text-fuchsia-400 fui-tracked mb-6" style="text-shadow: 0 0 26px rgba(255,46,109,0.45);">: ASTRA</div>
        <p class="text-lg text-slate-300 mb-3"><%= t('site.home.subtitle') %></p>
        <p class="text-slate-400 leading-relaxed max-w-xl mx-auto mb-10"><%= t('site.home.tagline') %></p>

        <div class="flex flex-wrap items-center justify-center gap-3">
        <% if (loggedIn) { %>
            <a href="/select-server" class="fui-btn fui-btn-solid inline-flex items-center gap-2 font-semibold py-3 px-8">
                <%= t('site.home.go_to_dashboard') %>
            </a>
        <% } %>
        <a href="#about" class="fui-btn <%= loggedIn ? '' : 'fui-btn-solid' %> inline-flex items-center gap-2 font-semibold py-3 px-8">
            <%= t('site.home.about_button') %>
        </a>
        </div>
        <div class="mt-6 text-sm text-slate-400 fui-tracked">
            <a href="/privacy" class="underline underline-offset-4 text-cyan-200 hover:text-white" style="text-shadow: 0 0 10px rgba(34,229,255,0.7), 0 0 22px rgba(34,229,255,0.35);"><%= t('site.legal.privacy_full') %></a>
            <span class="mx-3 text-slate-600">&middot;</span>
            <a href="/terms" class="underline underline-offset-4 text-cyan-200 hover:text-white" style="text-shadow: 0 0 10px rgba(34,229,255,0.7), 0 0 22px rgba(34,229,255,0.35);"><%= t('site.legal.terms_full') %></a>
        </div>
    </div>

    <!-- PUBLIC STATS (counts only; hidden until the bot is connected) -->
    <% if (typeof stats !== 'undefined' && stats && stats.servers !== null) { %>
    <div class="max-w-xl mx-auto px-5 sm:px-8 pb-12 grid grid-cols-2 gap-5 relative z-10">
        <div class="fui-panel fui-corners p-5 text-center">
            <div class="fui-brand text-3xl font-black text-cyan-300"><%= Number(stats.servers).toLocaleString('en-US') %></div>
            <div class="fui-tracked text-[11px] uppercase text-slate-500 mt-1"><%= t('site.home.stat_servers') %></div>
        </div>
        <div class="fui-panel fui-corners p-5 text-center">
            <div class="fui-brand text-3xl font-black text-cyan-300"><%= Number(stats.members).toLocaleString('en-US') %></div>
            <div class="fui-tracked text-[11px] uppercase text-slate-500 mt-1"><%= t('site.home.stat_members') %></div>
        </div>
    </div>
    <% } %>

    <!-- ABOUT -->
    <div id="about" class="max-w-4xl mx-auto px-5 sm:px-8 pb-24 relative z-10 scroll-mt-8">
        <div class="text-center mb-10">
            <div class="fui-tracked text-xs text-cyan-500/70 mb-3">// <%= t('site.home.about_kicker') %></div>
            <h2 class="fui-brand text-2xl sm:text-3xl font-black text-cyan-300 mb-4"><%= t('site.home.about_title') %></h2>
            <p class="text-slate-400 leading-relaxed max-w-2xl mx-auto"><%= t('site.home.about_intro') %></p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-cyan-400 rotate-45"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_verification') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_verification_desc') %></p>
            </div>
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-fuchsia-400" style="clip-path: polygon(50% 0, 100% 100%, 0 100%);"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_antiscam') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_antiscam_desc') %></p>
            </div>
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-cyan-400 rounded-full"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_tickets') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_tickets_desc') %></p>
            </div>
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-fuchsia-400 rotate-45 rounded-sm"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_community') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_community_desc') %></p>
            </div>
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-cyan-400" style="clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_personality') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_personality_desc') %></p>
            </div>
            <div class="fui-panel fui-corners p-6 text-center">
                <div class="w-8 h-8 mx-auto mb-4 border-2 border-fuchsia-400 rounded-full"></div>
                <h3 class="fui-tracked text-xs uppercase text-cyan-300 mb-2"><%= t('site.home.feature_dashboard') %></h3>
                <p class="text-sm text-slate-400"><%= t('site.home.feature_dashboard_desc') %></p>
            </div>
        </div>
    </div>

    <footer class="relative z-10 text-center text-sm text-slate-300 fui-tracked uppercase pb-10 px-5">
    <a href="/support" class="text-fuchsia-300 hover:text-fuchsia-200 transition" style="text-shadow: 0 0 10px rgba(255,46,109,0.7), 0 0 22px rgba(255,46,109,0.35);"><%= t('site.support.footer_support') %></a>
    <span class="mx-2">&middot;</span>
    <a href="/privacy" class="transition text-cyan-200 hover:text-white" style="text-shadow: 0 0 10px rgba(34,229,255,0.7), 0 0 22px rgba(34,229,255,0.35);"><%= t('site.legal.privacy_link') %></a>
    <span class="mx-2">&middot;</span>
    <a href="/terms" class="transition text-cyan-200 hover:text-white" style="text-shadow: 0 0 10px rgba(34,229,255,0.7), 0 0 22px rgba(34,229,255,0.35);"><%= t('site.legal.terms_link') %></a>
    <div class="mt-2 normal-case"><%= t('site.support.footer_credit') %></div>
</footer>

    <script>
        (function () {
            const btn = document.getElementById('astra-user-menu-btn');
            const menu = document.getElementById('astra-user-menu');
            if (!btn || !menu) return;

            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                menu.classList.toggle('hidden');
            });
            document.addEventListener('click', () => menu.classList.add('hidden'));
        })();
    </script>

</body>
</html>