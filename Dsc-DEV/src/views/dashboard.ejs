<%- include('partials/header') %>

<div class="max-w-5xl mx-auto space-y-6 md:space-y-8">
    <div class="mb-2">
        <h1 class="text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 tracking-tight">⚙️ Configuration</h1>
        <p class="text-slate-400 mt-1 text-sm md:text-base">Manage your server's security settings and verify members.</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-5 py-3 rounded-xl text-sm font-medium">
            ✓ Settings saved successfully.
        </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
        <div class="lg:col-span-2 space-y-6 md:space-y-8">

            <!-- VERIFICATION -->
            <div class="bg-slate-900/80 backdrop-blur p-5 md:p-8 rounded-2xl border border-slate-800 hover:border-slate-700 shadow-xl transition-colors">
                <h2 class="text-lg font-semibold text-white mb-1">Verification Gate</h2>
                <p class="text-sm text-slate-500 mb-6">Set both a rules channel/role and a verify channel/role to require both before granting the final role. Leave the rules fields blank to use single-step verification instead.</p>

                <form action="/api/update-verification" method="POST" class="space-y-6">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Rules Channel <span class="text-slate-600">(optional)</span></label>
                            <select name="rules_channel_id" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.rules_channel_id ? 'selected' : '' %>>None (single-step mode)</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= settings.rules_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Rules Role <span class="text-slate-600">(optional)</span></label>
                            <select name="rules_role_id" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.rules_role_id ? 'selected' : '' %>>None</option>
                                <% roles.forEach(role => { %>
                                    <option value="<%= role.id %>" <%= settings.rules_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Verify Channel</label>
                            <select name="verify_channel_id" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.verify_channel_id ? 'selected' : '' %>>Select a channel...</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= settings.verify_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Verify Role <span class="text-slate-600">(optional in single-step mode)</span></label>
                            <select name="verify_role_id" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.verify_role_id ? 'selected' : '' %>>None</option>
                                <% roles.forEach(role => { %>
                                    <option value="<%= role.id %>" <%= settings.verify_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-sm font-medium text-slate-400 mb-2">Final Member Role</label>
                            <select name="member_role_id" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.member_role_id ? 'selected' : '' %>>Select a role...</option>
                                <% roles.forEach(role => { %>
                                    <option value="<%= role.id %>" <%= settings.member_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-sm font-medium text-slate-400 mb-2">Log Channel <span class="text-slate-600">(shared by verification, anti-scam, auto-kick, tickets)</span></label>
                            <select name="log_channel_id" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="" <%= !settings.log_channel_id ? 'selected' : '' %>>None selected</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= settings.log_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg active:scale-[0.98]">
                        Save Verification
                    </button>
                </form>
            </div>

            <!-- ANTI-SCAM -->
            <div class="bg-slate-900/80 backdrop-blur p-5 md:p-8 rounded-2xl border border-slate-800 hover:border-slate-700 shadow-xl transition-colors">
                <h2 class="text-lg font-semibold text-white mb-1">Anti-Scam Protection</h2>
                <p class="text-sm text-slate-500 mb-6">Flag or auto-kick brand-new accounts on join — the classic scam-bot signature.</p>

                <form action="/api/update-antiscam" method="POST" class="space-y-6">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">

                    <div class="flex items-center justify-between p-4 bg-slate-950/50 rounded-xl border border-slate-800">
                        <label class="font-medium text-white text-sm">Enable Anti-Scam Checks</label>
                        <input type="checkbox" name="antiscam_enabled" <%= settings.antiscam_enabled ? 'checked' : '' %>
                            class="w-6 h-6 accent-indigo-500 cursor-pointer rounded">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Action</label>
                            <select name="antiscam_action" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                                <option value="log" <%= settings.antiscam_action !== 'kick' ? 'selected' : '' %>>Log only</option>
                                <option value="kick" <%= settings.antiscam_action === 'kick' ? 'selected' : '' %>>Kick automatically</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">Min. Account Age (hours)</label>
                            <input type="number" name="antiscam_min_age_hours" min="1" max="720" value="<%= settings.antiscam_min_age_hours || 24 %>"
                                class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                        </div>
                        <div class="flex items-end pb-1">
                            <label class="flex items-center gap-2 text-sm text-slate-400">
                                <input type="checkbox" name="antiscam_require_no_avatar" <%= settings.antiscam_require_no_avatar !== false ? 'checked' : '' %>
                                    class="w-5 h-5 accent-indigo-500 cursor-pointer rounded">
                                Require no avatar too
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg active:scale-[0.98]">
                        Save Anti-Scam Settings
                    </button>
                </form>
            </div>

            <!-- AUTO-KICK -->
            <div class="bg-slate-900/80 backdrop-blur p-5 md:p-8 rounded-2xl border border-slate-800 hover:border-slate-700 shadow-xl transition-colors">
                <h2 class="text-lg font-semibold text-white mb-1">Auto-Kick Unverified Members</h2>
                <p class="text-sm text-slate-500 mb-6">Bots, the owner, and Astra Admins are always exempt.</p>

                <form action="/api/update-autokick" method="POST" class="space-y-6">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">

                    <div class="flex items-center justify-between p-4 bg-slate-950/50 rounded-xl border border-slate-800">
                        <label class="font-medium text-white text-sm">Enable Auto-Kick</label>
                        <input type="checkbox" name="auto_kick_enabled" <%= settings.auto_kick_enabled ? 'checked' : '' %>
                            class="w-6 h-6 accent-indigo-500 cursor-pointer rounded">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-2">Grace Period (days)</label>
                        <input type="number" name="auto_kick_days" min="1" max="30" value="<%= settings.auto_kick_days || 2 %>"
                            class="w-full sm:w-40 bg-slate-950 border border-slate-800 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 text-white outline-none text-sm">
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition-all shadow-lg active:scale-[0.98]">
                        Save Auto-Kick Settings
                    </button>
                </form>
            </div>

        </div>

        <!-- SIDEBAR: STATUS + ASTRA ADMINS -->
        <div class="space-y-6">
            <div class="bg-slate-900/80 backdrop-blur p-5 md:p-6 rounded-2xl border border-slate-800 hover:border-slate-700 shadow-xl transition-colors space-y-6">
                <div>
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Server Status</h3>
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-3 w-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                        </span>
                        <span class="text-white font-medium text-sm">System Active</span>
                    </div>
                </div>
                <div class="pt-6 border-t border-slate-800">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Registered Artists</h3>
                    <p class="text-3xl font-black text-white"><%= artistCount %></p>
                </div>
                <div class="pt-6 border-t border-slate-800">
                    <a href="/tickets" class="block text-center bg-slate-800 hover:bg-slate-700 text-white font-medium py-2.5 rounded-lg transition text-sm">
                        🎫 Manage Tickets
                    </a>
                </div>
            </div>

            <div class="bg-slate-900/80 backdrop-blur p-5 md:p-6 rounded-2xl border border-slate-800 hover:border-slate-700 shadow-xl transition-colors">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4">Astra Admin Roles</h3>
                <p class="text-xs text-slate-500 mb-4">Roles here can use Astra's config commands (not this site) without needing real Administrator permission.</p>

                <div class="space-y-2 mb-4">
                    <% if (adminRoles.length === 0) { %>
                        <p class="text-slate-600 text-xs">Only real Administrators can configure Astra right now.</p>
                    <% } %>
                    <% adminRoles.forEach(role => { %>
                        <div class="flex items-center justify-between bg-slate-950/50 rounded-lg border border-slate-800 px-3 py-2">
                            <span class="text-sm text-white">@<%= role.name %></span>
                            <form action="/api/admins/remove" method="POST">
                                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                                <input type="hidden" name="role_id" value="<%= role.id %>">
                                <button type="submit" class="text-xs text-red-400 hover:text-red-300">Remove</button>
                            </form>
                        </div>
                    <% }) %>
                </div>

                <form action="/api/admins/add" method="POST" class="flex gap-2">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <select name="role_id" class="flex-1 min-w-0 bg-slate-950 border border-slate-800 rounded-lg p-2 text-white outline-none text-xs">
                        <option value="">Select a role...</option>
                        <% roles.forEach(role => { %>
                            <option value="<%= role.id %>">@<%= role.name %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-3 rounded-lg transition whitespace-nowrap">Add</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>