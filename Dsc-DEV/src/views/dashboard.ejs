<%- include('partials/header') %>

<div class="max-w-5xl mx-auto space-y-6 md:space-y-8">
    <div class="mb-2">
        <h1 class="fui-brand text-2xl md:text-3xl font-black text-cyan-300 fui-tracked" style="text-shadow: 0 0 20px rgba(34,229,255,0.3);"><%= t('dashboard.title').toUpperCase() %></h1>
        <p class="text-slate-400 mt-1 text-sm md:text-base"><%= t('dashboard.subtitle') %></p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="fui-panel fui-corners px-5 py-3 text-sm font-medium text-cyan-300">
            <%= t('dashboard.saved_banner') %>
        </div>
    <% } %>

    <!-- STATS STRIP -->
    <div class="grid grid-cols-3 gap-3 md:gap-4">
        <div class="fui-panel fui-corners p-4 text-center">
            <div class="flex items-center justify-center gap-2 mb-1">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
                </span>
                <span class="fui-tracked text-[10px] text-slate-500 uppercase"><%= t('dashboard.stats.status') %></span>
            </div>
            <p class="text-sm font-bold text-white"><%= t('dashboard.stats.status_active') %></p>
        </div>
        <div class="fui-panel fui-corners p-4 text-center">
            <div class="fui-tracked text-[10px] text-slate-500 uppercase mb-1"><%= t('dashboard.stats.members') %></div>
            <p class="text-lg font-black text-cyan-300"><%= memberCount !== null ? memberCount.toLocaleString() : '—' %></p>
        </div>
        <div class="fui-panel fui-corners p-4 text-center">
            <div class="fui-tracked text-[10px] text-slate-500 uppercase mb-1"><%= t('dashboard.stats.artists') %></div>
            <p class="text-lg font-black text-cyan-300"><%= artistCount %></p>
        </div>
    </div>

    <!-- TABS -->
    <div class="border-b border-cyan-500/15 flex overflow-x-auto">
        <button class="fui-tab-btn" data-tab="verification"><%= t('dashboard.tab.verification') %></button>
        <button class="fui-tab-btn" data-tab="welcome"><%= t('dashboard.tab.welcome') %></button>
        <button class="fui-tab-btn" data-tab="leveling"><%= t('dashboard.tab.leveling') %></button>
        <button class="fui-tab-btn" data-tab="fun"><%= t('dashboard.tab.fun') %></button>
        <button class="fui-tab-btn" data-tab="economy"><%= t('dashboard.tab.economy') %></button>
        <button class="fui-tab-btn" data-tab="antiscam"><%= t('dashboard.tab.antiscam') %></button>
        <button class="fui-tab-btn" data-tab="autokick"><%= t('dashboard.tab.autokick') %></button>
        <button class="fui-tab-btn" data-tab="tickets"><%= t('dashboard.tab.tickets') %></button>
        <button class="fui-tab-btn" data-tab="updates"><%= t('dashboard.tab.updates') %></button>
        <button class="fui-tab-btn" data-tab="admins"><%= t('dashboard.tab.admins') %></button>
    </div>

    <!-- VERIFICATION TAB -->
    <div class="fui-tab-panel" data-tab-content="verification">
        <div class="fui-panel fui-corners p-5 md:p-8">
            <h2 class="fui-section-title"><%= t('dashboard.verification.title') %></h2>
            <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.verification.desc') %></p>

            <form action="/api/update-language" method="POST" class="mb-6" data-autosave>
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <label class="fui-label"><%= t('dashboard.language.label') %> <span class="normal-case text-slate-600"><%= t('dashboard.language.hint') %></span></label>
                <select name="language" class="fui-input sm:w-72">
                    <option value="en" <%= settings.language !== 'pt-br' ? 'selected' : '' %>><%= t('dashboard.language.option_en') %></option>
                    <option value="pt-br" <%= settings.language === 'pt-br' ? 'selected' : '' %>><%= t('dashboard.language.option_ptbr') %></option>
                </select>
            </form>

            <form action="/api/update-admin-log" method="POST" class="mb-6" data-autosave>
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <label class="fui-label"><%= t('dashboard.adminlog.label') %> <span class="normal-case text-slate-600"><%= t('dashboard.adminlog.hint') %></span></label>
                <select name="admin_log_channel_id" class="fui-input sm:w-72">
                    <option value="" <%= !settings.admin_log_channel_id ? 'selected' : '' %>><%= t('dashboard.adminlog.none') %></option>
                    <% channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= settings.admin_log_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                    <% }) %>
                </select>
            </form>

            <form action="/api/update-verification" method="POST" class="space-y-6" data-autosave>
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="fui-label"><%= t('dashboard.verification.rules_channel_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.verification.optional_tag') %></span></label>
                        <select name="rules_channel_id" class="fui-input">
                            <option value="" <%= !settings.rules_channel_id ? 'selected' : '' %>><%= t('dashboard.verification.rules_channel_none') %></option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>" <%= settings.rules_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.verification.rules_role_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.verification.optional_tag') %></span></label>
                        <select name="rules_role_id" class="fui-input">
                            <option value="" <%= !settings.rules_role_id ? 'selected' : '' %>><%= t('dashboard.verification.none') %></option>
                            <% roles.forEach(role => { %>
                                <option value="<%= role.id %>" <%= settings.rules_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.verification.verify_channel_label') %></label>
                        <select name="verify_channel_id" required class="fui-input">
                            <option value="" <%= !settings.verify_channel_id ? 'selected' : '' %>><%= t('dashboard.verification.select_channel') %></option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>" <%= settings.verify_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.verification.verify_role_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.verification.verify_role_optional_tag') %></span></label>
                        <select name="verify_role_id" class="fui-input">
                            <option value="" <%= !settings.verify_role_id ? 'selected' : '' %>><%= t('dashboard.verification.none') %></option>
                            <% roles.forEach(role => { %>
                                <option value="<%= role.id %>" <%= settings.verify_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="fui-label"><%= t('dashboard.verification.member_role_label') %></label>
                        <select name="member_role_id" required class="fui-input">
                            <option value="" <%= !settings.member_role_id ? 'selected' : '' %>><%= t('dashboard.verification.select_role') %></option>
                            <% roles.forEach(role => { %>
                                <option value="<%= role.id %>" <%= settings.member_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="fui-label"><%= t('dashboard.verification.log_channel_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.verification.log_channel_hint') %></span></label>
                        <select name="log_channel_id" class="fui-input">
                            <option value="" <%= !settings.log_channel_id ? 'selected' : '' %>><%= t('dashboard.verification.log_channel_none') %></option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>" <%= settings.log_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <p class="text-xs text-slate-600 text-center fui-tracked"><%= t('dashboard.autosave_note') %></p>
            </form>

            <form action="/api/send-verification-panel" method="POST" class="mt-4">
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <button type="submit" class="fui-btn w-full py-2.5 text-sm text-cyan-300 border-cyan-500/30"><%= t('dashboard.verification.post_panel_button') %></button>
                <p class="text-xs text-slate-600 mt-2 text-center"><%= t('dashboard.verification.post_panel_hint') %></p>
            </form>
        </div>
    </div>

    <!-- WELCOME / LEAVE TAB -->
    <div class="fui-tab-panel" data-tab-content="welcome">
        <div class="space-y-6 md:space-y-8">
            <div class="fui-panel fui-corners p-5 md:p-8">
                <h2 class="fui-section-title"><%= t('dashboard.welcome.title') %></h2>
                <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.welcome.desc') %></p>

                <form action="/api/update-welcome" method="POST" class="space-y-6" data-autosave>
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <div class="flex items-center justify-between p-4 bg-black/40 border border-cyan-500/10">
                        <label class="font-medium text-white text-sm"><%= t('dashboard.welcome.enable_label') %></label>
                        <input type="checkbox" name="welcome_enabled" <%= settings.welcome_enabled ? 'checked' : '' %> class="w-6 h-6 accent-cyan-500 cursor-pointer">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="fui-label"><%= t('dashboard.welcome.channel_label') %></label>
                            <select name="welcome_channel_id" class="fui-input">
                                <option value="" <%= !settings.welcome_channel_id ? 'selected' : '' %>><%= t('dashboard.verification.select_channel') %></option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= settings.welcome_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="flex items-end pb-1">
                            <label class="flex items-center gap-2 text-sm text-slate-400">
                                <input type="checkbox" name="welcome_card_enabled" <%= settings.welcome_card_enabled !== false ? 'checked' : '' %> class="w-5 h-5 accent-cyan-500 cursor-pointer">
                                <%= t('dashboard.welcome.card_label') %>
                            </label>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="fui-label"><%= t('dashboard.welcome.message_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.welcome.placeholders_hint') %></span></label>
                            <textarea name="welcome_message" rows="2" class="fui-input" placeholder="Welcome {user} to **{server}**! You're member #{membercount}."><%= settings.welcome_message || '' %></textarea>
                        </div>
                    </div>
                    <p class="text-xs text-slate-600 text-center fui-tracked"><%= t('dashboard.autosave_note') %></p>
                </form>
            </div>

            <div class="fui-panel fui-corners p-5 md:p-8">
                <h2 class="fui-section-title"><%= t('dashboard.leave.title') %></h2>
                <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.leave.desc') %></p>

                <form action="/api/update-leave" method="POST" class="space-y-6" data-autosave>
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <div class="flex items-center justify-between p-4 bg-black/40 border border-cyan-500/10">
                        <label class="font-medium text-white text-sm"><%= t('dashboard.leave.enable_label') %></label>
                        <input type="checkbox" name="leave_enabled" <%= settings.leave_enabled ? 'checked' : '' %> class="w-6 h-6 accent-cyan-500 cursor-pointer">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="fui-label"><%= t('dashboard.leave.channel_label') %></label>
                            <select name="leave_channel_id" class="fui-input">
                                <option value="" <%= !settings.leave_channel_id ? 'selected' : '' %>><%= t('dashboard.verification.select_channel') %></option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= settings.leave_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="fui-label"><%= t('dashboard.leave.message_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.leave.placeholders_hint') %></span></label>
                            <textarea name="leave_message" rows="2" class="fui-input" placeholder="**{username}** has left the server. We're now at {membercount} members."><%= settings.leave_message || '' %></textarea>
                        </div>
                    </div>
                    <p class="text-xs text-slate-600 text-center fui-tracked"><%= t('dashboard.autosave_note') %></p>
                </form>
            </div>
        </div>
    </div>

    <!-- LEVELING TAB -->
    <div class="fui-tab-panel" data-tab-content="leveling">
        <div class="fui-panel fui-corners p-5 md:p-8">
            <h2 class="fui-section-title"><%= t('dashboard.leveling.title') %></h2>
            <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.leveling.desc') %></p>

            <form action="/api/update-leveling" method="POST" class="space-y-6" data-autosave>
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <div class="flex items-center justify-between p-4 bg-black/40 border border-cyan-500/10">
                    <label class="font-medium text-white text-sm"><%= t('dashboard.leveling.enable_label') %></label>
                    <input type="checkbox" name="leveling_enabled" <%= settings.leveling_enabled ? 'checked' : '' %> class="w-6 h-6 accent-cyan-500 cursor-pointer">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="fui-label"><%= t('dashboard.leveling.channel_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.leveling.channel_hint') %></span></label>
                        <select name="levelup_channel_id" class="fui-input">
                            <option value="" <%= !settings.levelup_channel_id ? 'selected' : '' %>><%= t('dashboard.leveling.channel_same') %></option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>" <%= settings.levelup_channel_id === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.leveling.cooldown_label') %></label>
                        <input type="number" name="xp_cooldown_seconds" min="5" max="3600" value="<%= settings.xp_cooldown_seconds || 60 %>" class="fui-input">
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.leveling.xp_min_label') %></label>
                        <input type="number" name="xp_min" min="1" max="1000" value="<%= settings.xp_min || 15 %>" class="fui-input">
                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.leveling.xp_max_label') %></label>
                        <input type="number" name="xp_max" min="1" max="1000" value="<%= settings.xp_max || 25 %>" class="fui-input">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="fui-label"><%= t('dashboard.leveling.message_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.leveling.placeholders_hint') %></span></label>
                        <textarea name="levelup_message" rows="2" class="fui-input" placeholder="🎉 {user} just reached **Level {level}**!"><%= settings.levelup_message || '' %></textarea>
                    </div>
                </div>
                <p class="text-xs text-slate-600 text-center fui-tracked"><%= t('dashboard.autosave_note') %></p>
            </form>

            <!-- LEVEL-UP ROLE REWARDS -->
            <div class="mt-10 pt-8 border-t border-cyan-500/10">
                <h3 class="fui-section-title"><%= t('dashboard.levelroles.title') %></h3>
                <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.levelroles.desc') %></p>

                <div class="space-y-2 mb-6">
                    <% if (levelRoles.length === 0) { %>
                        <p class="text-slate-600 text-xs"><%= t('dashboard.levelroles.none') %></p>
                    <% } %>
                    <% levelRoles.forEach(lr => { %>
                        <div class="flex items-center justify-between bg-black/40 border border-cyan-500/10 px-4 py-2.5">
                            <span class="text-sm text-white">
                                <span class="text-cyan-300 fui-tracked uppercase"><%= t('dashboard.levelroles.level_n', { level: lr.level }) %></span>
                                <span class="text-slate-600 mx-2">→</span>
                                <% if (lr.name) { %>@<%= lr.name %><% if (!lr.assignable) { %> <span class="text-amber-400 text-xs" title="<%= t('dashboard.levelroles.unassignable_hint') %>">⚠ <%= t('dashboard.levelroles.unassignable') %></span><% } %><% } else { %><span class="text-slate-500"><%= t('dashboard.levelroles.deleted_role') %></span><% } %>
                            </span>
                            <form action="/api/level-roles/remove" method="POST">
                                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                                <input type="hidden" name="level" value="<%= lr.level %>">
                                <button type="submit" class="text-xs text-fuchsia-400 hover:text-fuchsia-300 fui-tracked uppercase"><%= t('dashboard.levelroles.remove_button') %></button>
                            </form>
                        </div>
                    <% }) %>
                </div>

                <form action="/api/level-roles/add" method="POST" class="flex flex-col sm:flex-row gap-2">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <input type="number" name="level" min="1" max="1000" required placeholder="<%= t('dashboard.levelroles.level_placeholder') %>" class="fui-input sm:w-40">
                    <select name="role_id" required class="fui-input flex-1">
                        <option value=""><%= t('dashboard.levelroles.select_role') %></option>
                        <% roles.forEach(role => { %>
                            <option value="<%= role.id %>">@<%= role.name %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="fui-btn text-xs px-4 text-cyan-300 border-cyan-500/30 whitespace-nowrap"><%= t('dashboard.levelroles.add_button') %></button>
                </form>
                <p class="text-xs text-slate-600 mt-3"><%= t('dashboard.levelroles.replace_hint') %></p>

                <!-- CREATE MILESTONE ROLES FOR ME -->
                <div class="mt-8 pt-6 border-t border-cyan-500/10">
                    <h4 class="fui-tracked uppercase text-sm text-cyan-300 mb-1"><%= t('dashboard.levelroles.create_title') %></h4>
                    <p class="text-xs text-slate-500 mb-4"><%= t('dashboard.levelroles.create_desc') %></p>

                    <% if (roleResult.error) { %>
                        <div class="bg-black/40 border border-amber-500/40 px-4 py-2.5 text-xs text-amber-400 mb-4"><%= t('dashboard.levelroles.err_' + roleResult.error) %></div>
                    <% } else if (roleResult.done) { %>
                        <div class="bg-black/40 border border-cyan-500/40 px-4 py-2.5 text-xs text-cyan-300 mb-4"><%= t('dashboard.levelroles.create_result', { made: roleResult.made, reused: roleResult.reused, skipped: roleResult.skipped }) %></div>
                    <% } %>

                    <form action="/api/level-roles/create" method="POST" class="space-y-3">
                        <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                        <div class="grid sm:grid-cols-2 gap-3">
                            <div>
                                <label class="fui-label"><%= t('dashboard.levelroles.create_levels') %></label>
                                <input type="text" name="levels" required value="10, 20, 30, 40, 50" class="fui-input">
                            </div>
                            <div>
                                <label class="fui-label"><%= t('dashboard.levelroles.create_name') %></label>
                                <input type="text" name="name_template" maxlength="80" value="Level {level}" class="fui-input">
                            </div>
                        </div>
                        <div class="flex flex-wrap items-end gap-4">
                            <div>
                                <label class="fui-label"><%= t('dashboard.levelroles.create_color_from') %></label>
                                <input type="color" name="color_from" value="#5de0ff" class="h-9 w-16 bg-black/40 border border-cyan-500/20 cursor-pointer">
                            </div>
                            <div>
                                <label class="fui-label"><%= t('dashboard.levelroles.create_color_to') %></label>
                                <input type="color" name="color_to" value="#e040fb" class="h-9 w-16 bg-black/40 border border-cyan-500/20 cursor-pointer">
                            </div>
                            <label class="flex items-center gap-2 text-xs text-slate-400 pb-2">
                                <input type="checkbox" name="hoist"> <%= t('dashboard.levelroles.create_hoist') %>
                            </label>
                            <button type="submit" class="fui-btn text-xs px-4 text-cyan-300 border-cyan-500/30 whitespace-nowrap"><%= t('dashboard.levelroles.create_button') %></button>
                        </div>
                    </form>
                    <p class="text-xs text-slate-600 mt-3"><%= t('dashboard.levelroles.create_hint') %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- FUN TAB -->
    <div class="fui-tab-panel" data-tab-content="fun">
        <div class="fui-panel fui-corners p-5 md:p-8">
            <h2 class="fui-section-title"><%= t('dashboard.fun.title') %></h2>
            <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.fun.desc') %></p>

            <form action="/api/update-fun" method="POST" class="space-y-6" data-autosave>
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <div class="flex items-center justify-between p-4 bg-black/40 border border-cyan-500/10">
                    <label class="font-medium text-white text-sm"><%= t('dashboard.fun.enable_label') %></label>
                    <input type="checkbox" name="mention_replies_enabled" <%= settings.mention_replies_enabled !== false ? 'checked' : '' %> class="w-6 h-6 accent-cyan-500 cursor-pointer">
                </div>
                <p class="text-xs text-slate-600 text-center fui-tracked"><%= t('dashboard.autosave_note') %></p>
            </form>

            <!-- EXPERIMENTAL SMART REPLIES -->
            <div class="mt-10 pt-8 border-t border-cyan-500/10">
                <h3 class="fui-section-title"><%= t('dashboard.ai.title') %> <span class="fui-badge text-amber-400 border-amber-500/40 ml-2"><%= t('dashboard.ai.badge') %></span></h3>
                <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.ai.desc') %></p>
                <form action="/api/update-ai" method="POST" class="space-y-6" data-autosave>
