                    </div>
                    <div>
                        <label class="fui-label"><%= t('dashboard.updates.role_label') %> <span class="normal-case text-slate-600"><%= t('dashboard.updates.role_hint') %></span></label>
                        <select name="updates_role_id" class="fui-input">
                            <option value="" <%= !settings.updates_role_id ? 'selected' : '' %>><%= t('dashboard.updates.role_none') %></option>
                            <% roles.filter(r => !r.managed).forEach(role => { %>
                                <option value="<%= role.id %>" <%= settings.updates_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <p class="text-xs text-slate-600 fui-tracked">
                    <%= t('dashboard.updates.status', { last: settings.updates_last_version || '—', current: updatesVersion || '—' }) %>
                </p>
                <div class="flex justify-end">
                    <button type="submit" class="fui-btn py-2.5 px-8 text-sm text-cyan-300 border-cyan-500/30"><%= t('dashboard.updates.save') %></button>
                </div>
            </form>

            <div class="mt-10 pt-8 border-t border-cyan-500/10 grid grid-cols-1 sm:grid-cols-2 gap-5">
                <form action="/api/updates/create-channel" method="POST" data-confirm="<%= t('dashboard.updates.create_confirm') %>" onsubmit="return confirm(this.dataset.confirm);">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <p class="text-xs text-slate-500 mb-3"><%= t('dashboard.updates.create_desc') %></p>
                    <button type="submit" class="fui-btn w-full py-2.5 text-sm text-cyan-300 border-cyan-500/30"><%= t('dashboard.updates.create_button') %></button>
                </form>
                <form action="/api/updates/preview" method="POST">
                    <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                    <p class="text-xs text-slate-500 mb-3"><%= t('dashboard.updates.preview_desc') %></p>
                    <button type="submit" class="fui-btn w-full py-2.5 text-sm text-cyan-300 border-cyan-500/30 <%= settings.updates_enabled ? '' : 'opacity-40 cursor-not-allowed' %>" <%= settings.updates_enabled ? '' : 'disabled' %>><%= t('dashboard.updates.preview_button') %></button>
                </form>
            </div>
        </div>
    </div>

    <!-- ADMIN ROLES TAB -->
    <div class="fui-tab-panel" data-tab-content="admins">
        <div class="fui-panel fui-corners p-5 md:p-8">
            <h2 class="fui-section-title"><%= t('dashboard.admins.title') %></h2>
            <p class="text-sm text-slate-500 mb-6"><%= t('dashboard.admins.desc') %></p>

            <div class="space-y-2 mb-6">
                <% if (adminRoles.length === 0) { %>
                    <p class="text-slate-600 text-xs"><%= t('dashboard.admins.none') %></p>
                <% } %>
                <% adminRoles.forEach(role => { %>
                    <div class="flex items-center justify-between bg-black/40 border border-cyan-500/10 px-4 py-2.5">
                        <span class="text-sm text-white">@<%= role.name %></span>
                        <form action="/api/admins/remove" method="POST">
                            <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                            <input type="hidden" name="role_id" value="<%= role.id %>">
                            <button type="submit" class="text-xs text-fuchsia-400 hover:text-fuchsia-300 fui-tracked uppercase"><%= t('dashboard.admins.remove_button') %></button>
                        </form>
                    </div>
                <% }) %>
            </div>

            <form action="/api/admins/add" method="POST" class="flex gap-2">
                <input type="hidden" name="guild_id" value="<%= settings.guild_id %>">
                <select name="role_id" class="fui-input flex-1">
                    <option value=""><%= t('dashboard.admins.select_role') %></option>
                    <% roles.forEach(role => { %>
                        <option value="<%= role.id %>">@<%= role.name %></option>
                    <% }) %>
                </select>
                <button type="submit" class="fui-btn text-xs px-4 text-cyan-300 border-cyan-500/30 whitespace-nowrap"><%= t('dashboard.admins.add_button') %></button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const buttons = document.querySelectorAll('.fui-tab-btn');
        const panels = document.querySelectorAll('.fui-tab-panel');
        const params = new URLSearchParams(window.location.search);
        const initialTab = params.get('tab') || (params.get('edit') ? 'tickets' : '<%= activeTab %>') || 'verification';

        function activate(tab) {
            buttons.forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
            panels.forEach(p => p.classList.toggle('active', p.dataset.tabContent === tab));
        }

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                activate(btn.dataset.tab);
                const url = new URL(window.location);
                url.searchParams.set('tab', btn.dataset.tab);
                url.searchParams.delete('edit');
                window.history.replaceState({}, '', url);
            });
        });

        activate(initialTab);
    })();
</script>

<%- include('partials/footer') %>