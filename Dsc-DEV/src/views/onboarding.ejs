<%- include('partials/header') %>

<div class="max-w-3xl mx-auto">
    <div class="mb-8 md:mb-10 text-center sm:text-left">
        <h1 class="text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 tracking-tight">👋 Welcome to Astra, <%= user.username %>!</h1>
        <p class="text-slate-400 mt-2 text-sm md:text-base">Let's get your server set up. You can always come back and change anything later.</p>
    </div>

    <div class="space-y-5">

        <!-- STEP 1: VERIFICATION -->
        <% const verificationDone = !!(settings.verify_channel_id && settings.member_role_id); %>
        <div class="bg-slate-900 p-5 md:p-7 rounded-2xl border <%= verificationDone ? 'border-emerald-500/30' : 'border-slate-800' %> shadow-xl">
            <div class="flex items-start justify-between gap-4 mb-2">
                <h3 class="text-lg font-semibold text-white">Step 1 — Verification System</h3>
                <% if (verificationDone) { %>
                    <span class="shrink-0 text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">✓ Configured</span>
                <% } else { %>
                    <span class="shrink-0 text-xs font-semibold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-3 py-1 rounded-full">Not set up</span>
                <% } %>
            </div>
            <p class="text-slate-400 text-sm mb-5">Configure how your members join the server — verify channel, roles, and (optionally) a two-step rules gate.</p>
            <a href="/dashboard" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-6 rounded-xl transition-all shadow-lg active:scale-[0.98] text-sm">
                <%= verificationDone ? 'Review Verification' : 'Configure Verification' %>
            </a>
        </div>

        <!-- STEP 2: TICKETS -->
        <% const ticketsDone = !!(settings.ticket_channel_id && settings.ticket_category_id); %>
        <div class="bg-slate-900 p-5 md:p-7 rounded-2xl border <%= ticketsDone ? 'border-emerald-500/30' : 'border-slate-800' %> shadow-xl">
            <div class="flex items-start justify-between gap-4 mb-2">
                <h3 class="text-lg font-semibold text-white">Step 2 — Commission Tickets</h3>
                <% if (ticketsDone) { %>
                    <span class="shrink-0 text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">✓ Configured</span>
                <% } else { %>
                    <span class="shrink-0 text-xs font-semibold text-slate-500 bg-slate-800 border border-slate-700 px-3 py-1 rounded-full">Optional</span>
                <% } %>
            </div>
            <p class="text-slate-400 text-sm mb-5">Set up a ticket panel so members can open private commission requests with your artists.</p>
            <a href="/tickets" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-6 rounded-xl transition-all shadow-lg active:scale-[0.98] text-sm">
                <%= ticketsDone ? 'Review Tickets' : 'Configure Tickets' %>
            </a>
        </div>

    </div>

    <div class="mt-8 text-center">
        <a href="/dashboard" class="text-sm text-slate-500 hover:text-white transition">Skip for now — go straight to the dashboard →</a>
    </div>
</div>

<%- include('partials/footer') %>